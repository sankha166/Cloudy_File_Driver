# Exposed to the browser. Use the Supabase publishable/anon key only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Do not put GEMINI_API_KEY here. Set it as a Supabase Edge Function secret:
# npx supabase secrets set GEMINI_API_KEY=your-gemini-key
# Optional model override; the function defaults to gemini-2.0-flash:
# npx supabase secrets set GEMINI_MODEL=gemini-2.0-flash
